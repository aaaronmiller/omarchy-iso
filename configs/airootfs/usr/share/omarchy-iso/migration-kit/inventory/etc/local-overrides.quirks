# Surface Laptop 4 touchpad: palm + thumb rejection.
# Install to /etc/libinput/local-overrides.quirks (works on Fedora today AND on Omarchy).
#
# ONLY real libinput quirk keys belong here. The old file had AttrScrollFactor and
# AttrPointerAccel, which do not exist; one unknown key makes libinput discard
# EVERY quirk (journal: "Failed to load the device quirks"). Scroll speed and
# pointer speed live in the compositor config instead (configs/hypr/input.lua).
#
# Lower threshold = more aggressive rejection. Thumb thresholds must stay below
# the palm thresholds. Tune with real numbers from:
#   sudo libinput measure touchpad-pressure     (pacman: libinput-tools / dnf: libinput-utils)
#   sudo libinput measure touch-size
# Verify it loaded with:  sudo libinput quirks list /dev/input/by-path/*event-mouse  (or the touchpad's eventN)

[Surface Laptop 4 Touchpad]
MatchUdevType=touchpad
MatchName=Microsoft Surface 045E:09AF Touchpad
AttrPalmPressureThreshold=80
AttrPalmSizeThreshold=70
AttrThumbPressureThreshold=60
AttrThumbSizeThreshold=55
