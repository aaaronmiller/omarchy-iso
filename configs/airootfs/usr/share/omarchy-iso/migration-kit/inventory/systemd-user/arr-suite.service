[Unit]
Description=*arr Suite (Sonarr/Radarr/Lidarr/Prowlarr/qBittorrent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/containers/arr-suite
ExecStart=/home/cheta-surface/.local/bin/podman-compose up
ExecStop=/home/cheta-surface/.local/bin/podman-compose down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
