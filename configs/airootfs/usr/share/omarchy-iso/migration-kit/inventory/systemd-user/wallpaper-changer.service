[Unit]
Description=Random wallpaper changer (GNOME + Ghostty)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/code/scripts/wallpaper-changer.sh
Environment=DISPLAY=:0
# DBUS is auto-detected at runtime from /run/user/%U/bus

[Install]
WantedBy=graphical-session.target
