[Unit]
Description=Two-finger tap on the touchscreen = right click
Documentation=file:///usr/local/lib/surface-fixes/README-two-finger-click.md

[Service]
Type=simple
Environment=USER_XDG_RUNTIME_DIR=/run/user/__USER_UID__
Environment=TARGET_UID=__USER_UID__
# Root-owned path and -I (isolated mode): nothing from a user-writable directory is ever imported.
ExecStart=/usr/bin/python3 -I __LIBDIR__/two-finger-right-click.py
Restart=on-failure
RestartSec=2

# Hardening. What the daemon needs: read /dev/input/event*, write /dev/uinput, switch to the session user to run hyprctl,
# talk to unix sockets. Nothing else. (Review 2026-10-18; offline score in README.)
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
